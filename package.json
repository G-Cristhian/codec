{
  "name": "codec",
  "version": "0.1.0",
  "description": "Run AI coding agents on many projects at once, each in its own git worktree",
  "private": true,
  "type": "module",
  "main": "dist/app.js",
  "bin": {
    "codec": "./bin/codec"
  },
  "scripts": {
    "build": "node scripts/ensure-dependencies.mjs && tsc && vite build --config ui/vite.config.ts",
    "app": "npm run build && node scripts/run-app.mjs",
    "install-launcher": "npm run build && node dist/install-launcher.js",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p ui/tsconfig.json",
    "test": "vitest run",
    "postinstall": "node scripts/ensure-dependencies.mjs --record",
    "dev:ui": "node scripts/ensure-dependencies.mjs && vite --config ui/vite.config.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.1.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.71.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.5"
  }
}
